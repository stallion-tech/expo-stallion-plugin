{
  "name": "expo-stallion-plugin",
  "version": "1.0.4",
  "description": "Expo Config Plugin for react-native-stallion - automatically configures Stallion as the JS bundle provider",
  "main": "build/index.js",
  "types": "build/index.d.ts",
  "scripts": {
    "build": "tsc",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "expo",
    "expo-plugin",
    "react-native",
    "stallion",
    "bundle",
    "ota"
  ],
  "author": "",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/stallion-tech/expo-stallion-plugin"
  },
  "peerDependencies": {
    "expo": ">=47.0.0",
    "@expo/config-plugins": ">=5.0.0"
  },
  "peerDependenciesMeta": {
    "expo": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@expo/config-plugins": "^57.0.9",
    "@expo/config-types": "^57.0.2",
    "typescript": "^5.0.0",
    "@semantic-release/changelog": "^7.0.0",
    "@semantic-release/git": "^11.0.1",
    "semantic-release": "^25.0.9"
  },
  "files": [
    "build",
    "app.plugin.js"
  ],
  "release": {
    "branches": [
      "main",
      {
        "name": "alpha",
        "prerelease": true
      }
    ],
    "plugins": [
      "@semantic-release/commit-analyzer",
      "@semantic-release/release-notes-generator",
      "@semantic-release/changelog",
      "@semantic-release/npm",
      "@semantic-release/github",
      [
        "@semantic-release/git",
        {
          "assets": [
            "CHANGELOG.md",
            "package.json"
          ],
          "message": "chore(release): ${nextRelease.version}"
        }
      ]
    ]
  }
}
